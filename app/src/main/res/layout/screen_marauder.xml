<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/marauderScreenScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbarStyle="insideOverlay"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="10dp"
        android:paddingRight="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MARAUDER FIRMWARE IMAGE" />

            <TextView
                android:id="@+id/marauderFirmwareImageStatus"
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Preparing the offline bootable image…" />

            <TextView
                android:id="@+id/marauderUsbTargetStatus"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="No wired device assigned" />

            <Button
                android:id="@+id/selectMarauderUsbTarget"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="SELECT WIRED DEVICE" />

            <Button
                android:id="@+id/flashMarauderFirmware"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="PREPARING MARAUDER IMAGE" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="USB SERIAL LINK" />

            <TextView
                android:id="@+id/marauderConnectionStatus"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Marauder USB device connected" />

            <TextView
                android:id="@+id/marauderRecordingStatus"
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Session recording starts automatically with a device link" />

            <TextView
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="The app detects and opens Marauder automatically after USB-C attachment. Android must be the USB host; use Reconnect only for link recovery. USB is preferred while both links are connected." />

            <TextView
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="Validated with ESP32 Marauder v1.15.0-mobile.5 on the Heltec V4 device type. OLED PRG: 1x next, hold select/start, 2x back/stop; the first press wakes a blank display." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/marauderConnect" style="@style/ActionButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:layout_weight="1" android:text="RECONNECT USB" />
                <Button android:id="@+id/marauderDisconnect" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_weight="1" android:text="DISCONNECT USB" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BLUETOOTH UART LINK" />

            <TextView
                android:id="@+id/marauderBluetoothStatus"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marauder Bluetooth is not connected" />

            <TextView
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="The mobile firmware advertises a Marauder UART service for commands, console output, and virtual-SD synchronization. Passive BLE scans can share the radio; BLE transmit/spoof operations may temporarily interrupt this link." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/marauderBluetoothConnect" style="@style/ActionButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:layout_weight="1" android:text="CONNECT BLUETOOTH" />
                <Button android:id="@+id/marauderBluetoothDisconnect" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_weight="1" android:text="DISCONNECT" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STRUCTURED RESULTS" />

            <TextView
                android:id="@+id/marauderApResultsStatus"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Access points · no structured results yet" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/marauderViewApResults" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:layout_weight="1" android:text="VIEW APS" />
                <Button android:id="@+id/marauderExportApCsv" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_weight="1" android:text="EXPORT AP CSV" />
            </LinearLayout>

            <TextView
                android:id="@+id/marauderBleResultsStatus"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="BLE devices · no structured results yet" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/marauderViewBleResults" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:layout_weight="1" android:text="VIEW BLE" />
                <Button android:id="@+id/marauderExportBleCsv" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_weight="1" android:text="EXPORT BLE CSV" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QUICK ACTIONS // NO ATTACKS" />

            <Button
                android:id="@+id/marauderGuidedCommands"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ALL COMMANDS" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/cmdHelp" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="3dp" android:layout_weight="1" android:text="HELP" />
                <Button android:id="@+id/cmdGpsFix" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_weight="1" android:text="GPS FIX" />
                <Button android:id="@+id/cmdGpsData" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:layout_weight="1" android:text="GPS DATA" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/cmdWifiScan" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="3dp" android:layout_weight="1" android:text="AP SCAN" />
                <Button android:id="@+id/cmdBleScan" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_weight="1" android:text="BLE SCAN" />
                <Button android:id="@+id/cmdStop" style="@style/DangerButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:layout_weight="1" android:text="STOP" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/cmdListAp" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="3dp" android:layout_weight="1" android:text="LIST APS" />
                <Button android:id="@+id/cmdListBle" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_weight="1" android:text="LIST BLE" />
                <Button android:id="@+id/cmdPacketCount" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:layout_weight="1" android:text="COUNTS" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/SectionTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LIVE CONSOLE // 115200" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal">

                <Button android:id="@+id/consolePageUp" style="@style/ConsoleControlButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginRight="2dp" android:layout_weight="1" android:minHeight="0dp" android:text="UP" />
                <Button android:id="@+id/consolePageDown" style="@style/ConsoleControlButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:layout_weight="1" android:minHeight="0dp" android:text="DOWN" />
                <Button android:id="@+id/consoleLive" style="@style/ConsoleControlButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginLeft="2dp" android:layout_marginRight="2dp" android:layout_weight="1" android:minHeight="0dp" android:text="LIVE ON" />
                <Button android:id="@+id/consoleClear" style="@style/ConsoleControlButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginLeft="2dp" android:layout_weight="1" android:minHeight="0dp" android:text="CLEAR" />
            </LinearLayout>

            <TextView
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Drag inside the console or use UP/DOWN to pause auto-follow. Tap LIVE to resume at the newest output." />

            <TextView
                android:id="@+id/marauderConsole"
                style="@style/ConsoleText"
                android:text="Connect to begin.\n"
                />

            <EditText
                android:id="@+id/marauderCommand"
                style="@style/InputField"
                android:layout_marginTop="10dp"
                android:hint="Marauder command"
                android:imeOptions="actionSend"
                android:inputType="text" />

            <Button
                android:id="@+id/marauderSend"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SEND COMMAND" />

            <TextView
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Commands that transmit, change network state, reboot, or update firmware require a separate confirmation." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView style="@style/SectionTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SESSION HISTORY" />

            <TextView
                style="@style/MutedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Device sessions are timestamped in private app storage. Password-like join arguments are redacted before saving. History can be viewed, renamed, exported, shared, or deleted." />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/marauderSessionHistory" style="@style/ActionButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:layout_weight="1" android:text="SESSIONS" />
                <Button android:id="@+id/marauderExportConsole" style="@style/SecondaryButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_weight="1" android:text="EXPORT CONSOLE" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/MutedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Operate only on systems and radio spectrum you own or are authorized to test." />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
