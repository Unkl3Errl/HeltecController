<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- BruceNet is a local, isolated ESP32 access point with an HTTP-only WebUI. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.0.0.1</domain>
        <domain includeSubdomains="false">bruce.local</domain>
    </domain-config>
</network-security-config>
